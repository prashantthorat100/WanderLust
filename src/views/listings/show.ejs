<div class="row mt-5">
  <div class="col-8 offset-3">
    <h3>Listing Details:</h3>
  </div>

  
    <div class="col-6 offset-3 card show-card" >
      <img
        src="<%=listing.image.url%>"
        class="show-img card-img-top"
        alt="listing" 
      />
      <div class="card-body">
        <h3 class="card-text"><b><%= listing.title %></b></h3>
        <p class="card-text">
          <%=listing.description%> <br />
          &#8377;<%=listing.price.toLocaleString("en-IN")%> <br />
          <%=listing.location%> <br />
          <%=listing.country%>
        </p>
      </div>
    </div>
  
</div>
<div class=" btns mb-5 ">
  <a class="btn btn-danger edit-btn col-1 offset-3" href="/Listing/<%= listing._id %>/edit">EDIT </a>

  <form method="post" action="/Listing/<%= listing._id %>?_method=Delete">
    <button class=" offset-6 btn btn-danger">Delete</button>
  </form>
</div>
