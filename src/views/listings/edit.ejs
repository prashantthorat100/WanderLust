<div class="row mt-5">
  <div class="col-8 offset-2">
    <h3>Edit your Listings</h3>
    <form class="needs-validation" method="post" action="/Listing/<%= listing._id %>?_method=PUT" novalidate>
      <div class="mb-3">
        <label class="form-label" for="title">EDIT Title:</label>
        <input
          class="form-control"
          type="text"
          value="<%= listing.title %>"
          name="listing[title]"
          required
        />
        <div class="invalid-feedback">Title is required.</div>
      </div>

      <div class="mb-3">
        <label class="form-label" for="description">EDIT Description:</label>
        <textarea
          class="form-control"
          name="listing[description]"
          id="description"
          required
        >
<%= listing.description %></textarea
        >
        <div class="invalid-feedback">add small description</div>
      </div>

      <div class="mb-3">
        <label class="form-label" for="image">EDIT Image Url:</label>
        <input
          class="form-control"
          type="text"
          value="<%= listing.image.url %>"
          name="listing[image.url]"
          required
        />
      </div>

      <div class="row">
        <div class="mb-3 col-4">
        <label class="form-label" for="price">EDIT Price:</label>
        <input
          class="form-control"
          type="number"
          value="<%= listing.price %>"
          name="listing[price]"
          required
        />
        <div class="invalid-feedback">Price is required.</div>
      </div>

      <div class="mb-3 col-8">
        <label class="form-label" for="country">EDIT Country:</label>
        <input
          class="form-control"
          type="text"
          value="<%= listing.country %>"
          name="listing[country]"
          required
        />
        <div class="invalid-feedback">Country is required.</div>
      </div>
      </div>

      <div class="mb-3">
        <label class="form-label" for="location">EDIT Location:</label>
        <input
          class="form-control"
          type="text"
          value="<%= listing.location %>"
          name="listing[location]"
          required
        />
        <div class="invalid-feedback">Location is required.</div>
      </div>

      

      <button class="edit-btn btn btn-secondary mb-5">Click to EDIT</button>
    </form>
  </div>
</div>
